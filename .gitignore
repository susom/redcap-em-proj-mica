# IDE project files for IntelliJ - it tends to generate lots of files depending
# on your exact version, which plugins are installed, etc., so ignore everything
# except for a vetted list of things we want. In particular, we want code
# formatting style (which needs to match the checkstyle Maven configuration).
/.idea/*

# Don't want any encryption keys in version control
*.jks
*.jceks
*.pkcs12
*.pk12
*.pem
*.pfx

# Operating system garbage
.DS_Store
[Tt]humbs.db

# Emacs backup files
*~

*node_modules

# The module's own vendor/ IS committed: a REDCap EM deploys by directory copy, and
# opis/json-schema is a runtime dependency of the counselor turn path - a missing
# vendor/ would be a fatal mid-turn rather than a deploy-time error. It is built
# without dev dependencies; the test toolchain lives in tools/ so that a test
# framework structurally cannot end up in the deployed tree.
*vendor
!/vendor/
!/vendor/**

# ...and the toolchain that must NOT ship.
/tools/vendor/

# PHPUnit result/coverage cache
.phpunit.cache/
.phpunit.result.cache

# Playwright session state (contains REDCap session cookies)
docs/project-structure

# handoff/ is deliberately NOT ignored either. Those artifacts are hash-pinned and
# the running code refuses to work without them - see classes/ArtifactRegistry.php.

# E2E screenshots
e2e/shots/
