{
    "description": "REDCap external module: Project MICA. Runtime dependencies only - see tools/composer.json for the test toolchain.",
    "require": {
        "php": ">=8.2",
        "opis/json-schema": "^2.4"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Stanford\\MICA\\": "classes/"
        }
    },
    "scripts": {
        "test": "tools/vendor/bin/phpunit",
        "test:install": "composer install --working-dir=tools"
    }
}
