{
    "name": "Project MICA",
    "namespace": "Stanford\\MICA",
    "description": "An EM specific to the MICA project.  Chatbot Agent",
    "documentation": "README.md",
    "authors": [
        {
            "name": "Irvin Szeto",
            "email": "irvins@stanford.edu",
            "institution": "Stanford University"
        },
        {
            "name": "Jordan Schultz",
            "email": "jmschult@stanford.edu",
            "institution": "Stanford University"
        }
    ],
    "framework-version": 14,
    "enable-every-page-hooks-on-system-pages": true,
    "enable-no-auth-logging": true,
    "links": {
        "project": [
            {
                "name": "MICA Chatbot",
                "icon": "gear",
                "url": "pages/chatbot.php",
                "show-header-and-footer": false
            },
            {
                "name": "Mica Session Admin",
                "icon": "gear",
                "url": "pages/sessionSelector.php",
                "show-header-and-footer": true
            }
        ],
        "control-center": []
    },
    "no-auth-pages": [
        "pages/chatbot"
    ],
    "no-auth-ajax-actions": [
        "callAI",
        "login",
        "verifyEmail",
        "completeSession",
        "fetchSavedQueries"
    ],
    "project-settings": [
        {
            "key": "chat_host_instruments",
            "name": "Comma-delimited list of instruments that host the chat UI<br><i>(default = ui_hosting_instrument)</i>",
            "required": false,
            "type": "text",
            "default": "ui_hosting_instrument"
        },
        {
            "key": "chatbot_end_session_url_override",
            "name": "Optional URL Override for Redirect URL when 'End Session' is clicked",
            "required": true,
            "type": "text"
        },
        {
            "key": "chatbot_intro_text",
            "name": "Raw text to show in the UI on session start",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "session_length_days",
            "name": "Number of days in a session (default = 14)",
            "required": false,
            "type": "number",
            "default": 14
        },
        {
            "key": "number_session_callback",
            "name": "Number of previous sessions to hold in memory (default = 1)",
            "required": false,
            "type": "number",
            "default": 1
        },
        {
            "key": "chatbot_end_session_text",
            "name": "Raw text to show in the UI to remind participant to 'end session'",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_redcap_inject",
            "name": "Comma delimited list of instruments to inject into the Chat Context",
            "required": false,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_general",
            "name": "Raw text to inject into and set the chatbot's overall system context, persona, guardrails",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_baseline",
            "name": "Raw text to inject into and tune the chatbot's baseline session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_2",
            "name": "Raw text to inject into and tune the chatbot's 2nd session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_3",
            "name": "Raw text to inject into and tune the chatbot's 3rd session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_4",
            "name": "Raw text to inject into and tune the chatbot's 4th session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_5",
            "name": "Raw text to inject into and tune the chatbot's 5th session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_6",
            "name": "Raw text to inject into and tune the chatbot's 6th session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "chatbot_system_context_session_7",
            "name": "Raw text to inject into and tune the chatbot's 7th session system context",
            "required": true,
            "type": "textarea"
        },
        {
            "key": "enable-transcript-finalization",
            "name": "<b>Finalize transcripts and queue safety scans</b><br><i>When a session completes, snapshot an immutable transcript into the EM log and queue a post-session SafetyScan job. Off leaves the pilot behaviour untouched.</i>",
            "required": false,
            "type": "checkbox"
        },
        {
            "key": "session-host-map",
            "name": "<b>Session host map</b><br><i>One <code>instrument:session_type:setting</code> per line. <code>session_type</code> is <code>baseline</code> or <code>booster</code>; <code>setting</code> is <code>emergency_department</code>, <code>remote_followup</code> or <code>other_approved</code> (the pinned SafetyScan schema's vocabulary). Blank uses the R01 defaults: <code>mica_ed_session:baseline:emergency_department</code> and <code>mica_booster_session:booster:remote_followup</code>.</i>",
            "required": false,
            "type": "textarea"
        },
        {
            "key": "safetyscan-model-alias",
            "name": "<b>SafetyScan model alias</b><br><i>Must match a SecureChatAI registry alias. The handoff names <code>gemini-3.5-flash</code> for production; dev uses <code>gemini-2.5-flash</code>.</i>",
            "required": false,
            "type": "text"
        },
        {
            "key": "safetyscan-max-attempts",
            "name": "<b>SafetyScan attempts before manual review</b><br><i>Default 3. Transient failures retry with backoff; once attempts are exhausted the job becomes a visible manual-review task - never a clean screen.</i>",
            "required": false,
            "type": "text"
        },
        {
            "key": "scan-mock-mode",
            "name": "<b>Scan mock mode</b> <span style=\"color:#c00\">(development only)</span><br><i>Replay fixtures instead of calling a model. Must be off in production; the launch-readiness gate refuses production while it is on.</i>",
            "required": false,
            "type": "checkbox"
        },
        {
            "key": "enable-project-debug-logging",
            "name": "<b>Enable Debug Logging</b><br><i>(optional)</i> Requires installation and configuration of emLogger",
            "required": false,
            "type": "checkbox"
        },
        {
            "key": "llm-model",
            "name": "<b>LLM Model</b><br><i>Values must match a SecureChatAI model alias (its <code>api-settings</code> registry). An unregistered alias does not error visibly - SecureChatAI returns a canned apology that this module would store as a counselor turn.</i>",
            "required": false,
            "type": "dropdown",
            "choices": [
                {
                    "value": "gpt-4-1",
                    "name": "GPT-4.1 (SecureChatAI prod default)"
                },
                {
                    "value": "gpt-4-1-nano",
                    "name": "GPT-4.1 nano"
                },
                {
                    "value": "gpt-5-4",
                    "name": "GPT-5.4 (json_schema-capable - phase-3 counselor)"
                },
                {
                    "value": "gpt-5-4-nano",
                    "name": "GPT-5.4 nano"
                },
                {
                    "value": "o3",
                    "name": "o3 (reasoning)"
                },
                {
                    "value": "o4-mini",
                    "name": "o4-mini (reasoning)"
                },
                {
                    "value": "claude-sonnet-4.6",
                    "name": "Claude Sonnet 4.6"
                },
                {
                    "value": "claude-opus-4-7",
                    "name": "Claude Opus 4.7"
                },
                {
                    "value": "claude-haiku-4-5",
                    "name": "Claude Haiku 4.5 (dev registry)"
                },
                {
                    "value": "gemini-2.5-flash",
                    "name": "Gemini 2.5 Flash"
                },
                {
                    "value": "gemini-2.5-pro",
                    "name": "Gemini 2.5 Pro"
                }
            ],
            "default": "gpt-4-1"
        },
        {
            "key": "gpt-temperature",
            "name": "GPT Temperature",
            "required": false,
            "type": "number",
            "default": 0.7
        },
        {
            "key": "gpt-top-p",
            "name": "GPT Top P",
            "required": false,
            "type": "number",
            "default": 0.9
        },
        {
            "key": "gpt-frequency-penalty",
            "name": "GPT Frequency Penalty",
            "required": false,
            "type": "number",
            "default": 0.5
        },
        {
            "key": "gpt-presence-penalty",
            "name": "GPT Presence Penalty",
            "required": false,
            "type": "number",
            "default": 0
        },
        {
            "key": "gpt-max-tokens",
            "name": "GPT Max Tokens",
            "required": false,
            "type": "number",
            "default": 800
        },
        {
            "key": "reasoning-effort",
            "name": "<b>Reasoning Effort</b>  <br>(only applicable to o1, o3-mini reasoning models)",
            "required": false,
            "type": "dropdown",
            "choices": [
                {
                    "value": "low",
                    "name": "low"
                },
                {
                    "value": "medium",
                    "name": "medium"
                },
                {
                    "value": "high",
                    "name": "high"
                }
            ],
            "default": "medium"
        },
        {
            "key": "materialize-assigned-arm",
            "name": "<b>Automatically add the record to its randomized arm</b><br><i>When the allocation field below has a value, the record is added to the first event of that arm, so a CRC never has to create it inside the arm by hand. Only the assigned arm is touched.</i>",
            "required": false,
            "type": "checkbox"
        },
        {
            "key": "study-group-field",
            "name": "<b>Allocation field</b><br><i>Field holding the assigned study group. Its value must be the arm number (1, 2, 3). Defaults to <code>study_group</code>.</i>",
            "required": false,
            "type": "field-list"
        }
    ],
    "system-settings": [
        {
            "key": "enable-system-debug-logging",
            "name": "<b>Enable Debug Logging (system-wide)</b><i>(optional)</i> Requires installation and configuration of emLogger",
            "required": false,
            "type": "checkbox"
        },
        {
            "key": "twilio-sid",
            "name": "<b>Twilio SID</b>",
            "required": true,
            "type": "text"
        },
        {
            "key": "twilio-auth-token",
            "name": "<b>Twilio Auth token</b>",
            "required": true,
            "type": "text"
        },
        {
            "key": "twilio-from-number",
            "name": "<b>Twilio From Number </b><br><i>e.g +16124823490</i>",
            "required": true,
            "type": "text"
        }
    ],
    "compatibility": {
        "php-version-min": "",
        "php-version-max": "",
        "redcap-version-min": "",
        "redcap-version-max": ""
    },
    "crons": [
        {
            "cron_name": "mica_scan_worker",
            "cron_description": "Runs queued post-session SafetyScan jobs and returns jobs abandoned by dead workers to the queue. Every minute, bounded to a small batch and a wall-clock budget so a slow pass cannot overrun its own interval and stack workers.",
            "method": "micaScanWorkerCron",
            "cron_frequency": "60",
            "cron_max_run_time": "300"
        }
    ]
}
